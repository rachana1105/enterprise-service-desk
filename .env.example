# Copy to .env and replace EVERY value. Never commit .env.
# Generate random values, e.g.:  openssl rand -base64 48
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# At least 32 bytes. The backend refuses to start with a short value or one starting "change-this".
JWT_SECRET=

# Schema handling: "update" ONLY for the first run against a new, empty local database;
# afterwards, and for every upgrade, use "validate" (never alters existing tables).
JPA_DDL_AUTO=update

# Local demonstration accounts (admin@/engineer@/employee@demo.local). Keep false outside a
# local demo. When true, DEMO_PASSWORD (12+ characters) is required and used for all three.
DEMO_SEED=false
DEMO_PASSWORD=

# Optional: pinned base images written by scripts/pin-images.ps1 / scripts/pin-images.sh.
# MYSQL_IMAGE=mysql:8.4@sha256:...
# MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-17@sha256:...
# BACKEND_RUNTIME_IMAGE=gcr.io/distroless/java17-debian13:nonroot@sha256:...
# SECURE_RUNTIME_IMAGE=cgr.dev/chainguard/jre@sha256:...
# NODE_IMAGE=node:22-alpine@sha256:...
# NGINX_IMAGE=nginx:alpine@sha256:...
